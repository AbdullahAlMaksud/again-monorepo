{
  "name": "again-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified monorepo for Again — A minimal, local-first recurring task tracker and upkeep ecosystem",
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "landing-portal",
    "admin-portal",
    "server",
    "mobile-app"
  ],
  "scripts": {
    "dev:landing": "pnpm --filter again-web dev",
    "dev:admin": "pnpm --filter again-admin dev",
    "dev:server": "pnpm --filter again-server dev",
    "build:landing": "pnpm --filter again-web build",
    "build:admin": "pnpm --filter again-admin build",
    "build:server": "pnpm --filter again-server build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "keywords": [
    "monorepo",
    "recurring-tasks",
    "productivity",
    "offline-first",
    "local-first",
    "nextjs",
    "pnpm"
  ],
  "author": "Abdullah Al Maksud <maksud.workspace@gmail.com>",
  "license": "MIT"
}
